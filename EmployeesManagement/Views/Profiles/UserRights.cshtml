@model EmployeesManagement.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Assign User Rights";
}

<div class="card">
    <div class="card-body">
        <div class="row">
            <form asp-action="UserGroupRights" class="form-horizontal">
                
                <div class="form-group col-md-6">
                    <label asp-for="RoleId" class="control-label"></label>
                    <select asp-for="RoleId" class="form-control onchange" asp-items="ViewBag.RoleId"></select>
                    <a class="currentrooturl" href="~/Profiles/UserRights"></a>
                </div>

                <div class="col-md-12">
                    <div id="tree">
                        <ul id="treeData" class="hummingbird-treeview">

                            <!-- Grandparent -->
                            <li>
                                <input class="grandparent" value="0" type="checkbox" />
                                <i class="bx bx-folder-open"></i> All Modules

                                <ul>
                                    @foreach (var item in Model.Profiles)
                                    {
                                        <li>
                                            <!-- Parent -->
                                            <input class="parent"
                                                   value="@item.Id"
                                                   name="Ids[]"
                                                   type="checkbox"
                                            @(Model.RolesRightsIds.Contains(item.Id) ? "checked" : "") />

                                            <i class="bx bx-folder-open"></i>
                                            <span>@item.Name</span>

                                            @if (item.Children.Any())
                                            {
                                                <ul>
                                                    @foreach (var child in item.Children.OrderBy(c => c.Order))
                                                    {
                                                        <li>
                                                            <!-- Child -->
                                                            <input class="child"
                                                                   value="@child.Id"
                                                                   name="Ids[]"
                                                                   type="checkbox"
                                                            @(Model.RolesRightsIds.Contains(child.Id) ? "checked" : "") />

                                                            @if (!child.Children.Any())
                                                            {
                                                                <i class="bi bi-lock-fill"></i>
                                                                @child.Name
                                                            }
                                                            else
                                                            {
                                                                <i class="bx bx-folder-open"></i>
                                                                <span>@child.Name</span>

                                                                <ul>
                                                                    @foreach (var childInner in child.Children.OrderBy(c => c.Order))
                                                                    {
                                                                        <li>
                                                                            <input class="child"
                                                                                   value="@childInner.Id"
                                                                                   name="Ids[]"
                                                                                   type="checkbox"
                                                                            @(Model.RolesRightsIds.Contains(childInner.Id) ? "checked" : "") />
                                                                            @childInner.Name
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>

                        </ul>
                    </div>
                    <div class="form-group">
                        <div class="col-md-12">
                            <a asp-action="Index" class="btn btn-warning float-start"><i class="bi bi-skip-backward-fill"></i> Back To List</a>
                            <button type="submit" class="btn btn-primary float-end"><i class="bi bi-save-fill"></i> Assign Rights</button>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Role dropdown change redirect
        $('.onchange').on('change', function () {
            window.location = $('.currentrooturl').attr('href') + '/' + $(this).val();
        });

        // Checkbox hierarchy logic
        $('input.parent, input.grandparent, input.child').on('change', function () {
            $(this).closest('li').find("input[type='checkbox']").prop('checked', this.checked);
        });
    </script>
}