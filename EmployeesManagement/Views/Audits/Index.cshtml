@model IEnumerable<EmployeesManagement.Models.Audit>

@{
    ViewData["Title"] = "System Audit Logs";
}

<p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> System Audit Logs</a>
</p>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Employees List</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.UserId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AuditType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TableName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateTime)
                    </th>
          
           
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.User.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AuditType)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TableName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateTime)
                        </td>
           
           
                        <td>
                            <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.Id"><i class="bi bi-eye-fill"></i>View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
