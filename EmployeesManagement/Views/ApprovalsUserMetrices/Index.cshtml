@model IEnumerable<EmployeesManagement.Models.ApprovalsUserMetrix>

@{
    ViewData["Title"] = "Approval Matrix";
}

<div class="card">
  
    <div class="card-header">
        <div class="mb-3 float-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-file-plus-fill"></i> Add New User Matrix
            </a>
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.User)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.WorkflowUserGroup)
                    </th>
                 
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedById)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedOn)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Active)
                    </th>
                    <th>Action</th>
                   

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.User.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentType.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.WorkflowUserGroup.Description)
                        </td>
                        
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedBy.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedOn)
                        </td>
                        <td>
                            @if (item.Active)
                            {
                                <span class="badge rounded-pill bg-success">
                                    Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning">
                                    No
                                </span>
                            }

                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Active)
                        </td>
            
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Update</a>
                
                        </td>
                      
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>