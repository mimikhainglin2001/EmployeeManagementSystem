@model EmployeesManagement.Models.Employee

@{
    ViewData["Title"] = "Details";
}
<h1>Employee Details</h1>
<div class="col-md-12">
    <!-- Tabs -->
    <ul class="nav nav-pills hr-tabs mb-3 gap-4" id="employeetabs" role="tablist">
        <li class="nav-item mr-3">
            <button class="nav-link active" data-toggle="pill" data-target="#profile" type="button" role="tab">
                <i class="bi bi-person"></i>
                Profile
            </button>
        </li>
        <li class="nav-item mr-3">
            <a class="nav-link" asp-action="EmployeeDocuments" asp-route-id="@Model.Id">
                <i class="bi bi-file-earmark"></i>
                Documents
            </a>
        </li>
        <li class="nav-item mr-3">
            <!-- FIXED: nok -->
            <button class="nav-link" data-toggle="pill" data-target="#nok" type="button" role="tab">
                <i class="bi bi-people"></i>
                Next of Kin
            </button>
        </li>
        <li class="nav-item mr-3">
            <button class="nav-link" data-toggle="pill" data-target="#contracts" type="button" role="tab">
                <i class="bi bi-file-text"></i>
                Contracts
            </button>
        </li>
        <li class="nav-item mr-3">
            <button class="nav-link" data-toggle="pill" data-target="#history" type="button" role="tab">
                <i class="bi bi-clock-history"></i>
                History
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content mt-3" id="employeetabsContent">

        <!-- PROFILE -->
        <div class="tab-pane fade show active" id="profile" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <table class="table table-bordered table-striped">
                        <tbody>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.EmpNo)</th>
                                <td>@Html.DisplayFor(model => model.EmpNo)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                                <td>@Html.DisplayFor(model => model.FirstName)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.MiddleName)</th>
                                <td>@Html.DisplayFor(model => model.MiddleName)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.LastName)</th>
                                <td>@Html.DisplayFor(model => model.LastName)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                                <td>@Html.DisplayFor(model => model.PhoneNumber)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.EmailAddress)</th>
                                <td>@Html.DisplayFor(model => model.EmailAddress)</td>
                            </tr>
                            <tr>
                                <th>Country</th>
                                <td>@Model.Country?.Name</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th>
                                <td>@Html.DisplayFor(model => model.DateOfBirth)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.EmploymentDate)</th>
                                <td>@Html.DisplayFor(model => model.EmploymentDate)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.EmploymentTerms)</th>
                                <td>@Html.DisplayFor(model => model.EmploymentTerms)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Address)</th>
                                <td>@Html.DisplayFor(model => model.Address)</td>
                            </tr>
                            <tr>
                                <th>Department</th>
                                <td>@Model.Department?.Name</td>
                            </tr>
                            <tr>
                                <th>Designation</th>
                                <td>@Model.Designation?.Name</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.KRAPIN)</th>
                                <td>@Html.DisplayFor(model => model.KRAPIN)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.NSSFNO)</th>
                                <td>@Html.DisplayFor(model => model.NSSFNO)</td>
                            </tr>
                            <tr>
                                <th>Bank</th>
                                <td>@Model.Bank?.Name</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.BankAccountNumber)</th>
                                <td>@Html.DisplayFor(model => model.BankAccountNumber)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.IBAN)</th>
                                <td>@Html.DisplayFor(model => model.IBAN)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.AllocatedLeaveDays)</th>
                                <td>@Html.DisplayFor(model => model.AllocatedLeaveDays)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.LeaveOustandingBalance)</th>
                                <td>@Html.DisplayFor(model => model.LeaveOustandingBalance)</td>
                            </tr>
                            <tr>
                                <th>Gender</th>
                                <td>@Model.Gender?.Description</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- DOCUMENTS -->
        <div class="tab-pane fade" id="documents" role="tabpanel">
                    <h1>Employee Details</h1>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Type</th>
                        <th>Uploaded</th>
                        <th>Expiry</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- TODO: Loop documents here -->
                    <tr>
                        <td colspan="5" class="text-center">No documents available</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- NEXT OF KIN -->
        <div class="tab-pane fade" id="nok" role="tabpanel">
                    <h1>Employee Next of Kin</h1>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Relationship</th>
                        <th>Phone Number</th>
                        <th>Primary</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- TODO: Loop NOK here -->
                    <tr>
                        <td colspan="5" class="text-center">No records available</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- CONTRACTS -->
        <div class="tab-pane fade" id="contracts" role="tabpanel">
                    <h1>Employee Contracts</h1>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Contract</th>
                        <th>Type</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center">No contracts available</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- HISTORY -->
        <div class="tab-pane fade" id="history" role="tabpanel">
                    <h1>Employee History</h1>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Change Type</th>
                        <th>Old Role</th>
                        <th>New Role</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center">No history available</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- Back Button -->
<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-skip-backward-fill"></i> Back to List
    </a>
</div>