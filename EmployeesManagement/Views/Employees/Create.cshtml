@model EmployeesManagement.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="row">
    <div class="col-xl-12 mx-auto">
        <div class="card border-top border-0 border-4 border-info">
            <div class="card-body">
                <div class="border p-4 rounded">

                    <div class="card-title d-flex align-items-center">
                        <div>
                            <i class="btn-xs bxs-user me-1 font-22 text-info"></i>
                        </div>
                        <h5 class="mb-0 text-info">Add New Employee</h5>
                    </div>

                    <hr />

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">

                      @*   <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EmpNo" class="control-label"></label>
                                <input asp-for="EmpNo" class="form-control" />
                                <span asp-validation-for="EmpNo" class="text-danger"></span>
                            </div>
                        </div> *@

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FirstName"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="MiddleName"></label>
                                <input asp-for="MiddleName" class="form-control" />
                                <span asp-validation-for="MiddleName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="LastName"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="PhoneNumber"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EmailAddress"></label>
                                <input asp-for="EmailAddress" class="form-control" />
                                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="GenderId"></label>
                                <select asp-for="GenderId" class="form-control" asp-items="ViewBag.GenderId">
                                    <option value="">Select Gender</option>
                                </select>
                                <span asp-validation-for="GenderId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CountryId"></label>
                                <select asp-for="CountryId" class="form-control" asp-items="ViewBag.CountryId">
                                        <option value="">Select Country</option>
                                </select>
                                <span asp-validation-for="CountryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DateOfBirth"></label>
                                <input asp-for="DateOfBirth" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EmploymentDate"></label>
                                <input asp-for="EmploymentDate" class="form-control" />
                                <span asp-validation-for="EmploymentDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Address"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DepartmentId"></label>
                                <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId">
                                        <option value="">Select Department</option>

                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DesignationId"></label>
                                <select asp-for="DesignationId" class="form-control" asp-items="ViewBag.DesignationId">
                                        <option value="">Select Designation</option>

                                </select>
                                <span asp-validation-for="DesignationId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="BankId"></label>
                                <select asp-for="BankId" class="form-control" asp-items="ViewBag.BankId">
                                        <option value="">Select Bank</option>

                                </select>
                                <span asp-validation-for="BankId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="BankAccountNumber"></label>
                                <input asp-for="BankAccountNumber" class="form-control" />
                                <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="IBAN"></label>
                                <input asp-for="IBAN" class="form-control" />
                                <span asp-validation-for="IBAN" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SWIFTCode"></label>
                                <input asp-for="SWIFTCode" class="form-control" />
                                <span asp-validation-for="SWIFTCode" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="NSSFNO"></label>
                                <input asp-for="NSSFNO" class="form-control" />
                                <span asp-validation-for="NSSFNO" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="NHIF"></label>
                                <input asp-for="NHIF" class="form-control" />
                                <span asp-validation-for="NHIF" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CompanyEmail"></label>
                                <input asp-for="CompanyEmail" class="form-control" />
                                <span asp-validation-for="CompanyEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="KRAPIN"></label>
                                <input asp-for="KRAPIN" class="form-control" />
                                <span asp-validation-for="KRAPIN" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="PassportNo"></label>
                                <input asp-for="PassportNo" class="form-control" />
                                <span asp-validation-for="PassportNo" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EmploymentTermsId"></label>
                                <select asp-for="EmploymentTermsId" class="form-control" asp-items="ViewBag.EmploymentTermsId">
                                        <option value="">Select Employment Terms</option>

                                </select>
                                <span asp-validation-for="EmploymentTermsId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DisabilityId"></label>
                                <select asp-for="DisabilityId" class="form-control" asp-items="ViewBag.DisabilityId">
                                        <option value="">Select Disability Type</option>

                                </select>
                                <span asp-validation-for="DisabilityId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DisabilityCertificate"></label>
                                <input asp-for="DisabilityCertificate" class="form-control" />
                                <span asp-validation-for="DisabilityCertificate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Photo"></label>
                                <input class="form-control" type="file" accept=".png,.jpg,.jpeg" id="photo" name="employeephoto" />
                                <span asp-validation-for="Photo" class="text-danger"></span>
                            </div>
                        </div>
                        

                    </div>

                    <br/>

                    <div class="form-group">
                            <button type="submit" class="btn btn-primary float-end"><i class="bi bi-save-fill"></i> Register Employee </button>
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-skip-backward-fill"></i> Back to List</a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}