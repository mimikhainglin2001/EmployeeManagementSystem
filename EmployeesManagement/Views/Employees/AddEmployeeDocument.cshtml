@model EmployeesManagement.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Add New Documents";
}

<div class="row">
    <div class="col-xl-12 mx-auto">
        <div class="card border-top border-0 border-4 border-info">
            <div class="card-body">
                <div class="border p-4 rounded">

                    <div class="card-title d-flex align-items-center">
                        <div>
                            <i class="btn-xs bxs-user me-1 font-22 text-info"></i>
                        </div>
                        <h5 class="mb-0 text-info">Add New Employee Document</h5>
                    </div>

                    <hr />
    <div class="card-body">
        <form asp-action="SubmitEmployeeDocument" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id"/>        
            <input type="hidden" asp-for="EmpNo"/>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-group">
                                <label asp-for="DocumentTypeId"></label>
                                <select asp-for="DocumentTypeId" class="form-control" asp-items="ViewBag.DocumentTypeId">
                                    <option value="">Select Document Type</option>
                                </select>
                                <span asp-validation-for="DocumentTypeId" class="text-danger"></span>
                            </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DocumentName" class="form-label"></label>
                    <input asp-for="DocumentName" class="form-control" />
                    <span asp-validation-for="DocumentName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ExpiryDate" class="form-label"></label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                </div>
        

                <div class="col-md-6 mb-3">
                    <label asp-for="Attachment" class="form-label"></label>
                    <input class="form-control" type="file" accept=".pdf,.png,.jpeg, .jpg" id="attachment" name="employeeattachment" />
                    <span asp-validation-for="Attachment" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary float-end"><i class="bi bi-save-fill"></i> Upload Attachment </button>

                <a asp-action="Index" class="btn btn-secondary float-start"><i class="bi bi-skip-backward-fill"></i> Back to List</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
</div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}