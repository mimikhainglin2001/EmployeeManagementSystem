@model EmployeesManagement.ViewModels.RolesViewModel

@{
    ViewData["Title"] = "Add New Role";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">New Role</h3>
    </div>

    <div class="card-body">
        <form asp-controller="Roles" asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RoleName"></label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-warning float-start"><i class="bi bi-skip-backward-fill"></i> Back To List</a>
                    <button type="submit" class="btn btn-primary float-end"><i class="bi bi-save-fill"></i> Register System Role </button>
                </div>
            </div>

        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}