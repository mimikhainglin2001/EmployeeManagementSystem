@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>


@{
    ViewData["Title"] = "System Roles";
}

<div class="card">
    <div class="card-header">
        <div class="mb-3 float-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-file-plus-fill"></i> Add New Role
            </a>
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        Role No
                    </th>
                    <th>
                        Role Name
                    </th>
                   
                    
           
          
                    <th>Actions</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button" class="btn btn-primary">
                                    Actions
                                </button>

                                <button type="button"
                                        class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false">
                                    <span class="sr-only"></span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-right">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <a class="dropdown-item text-secondary" asp-action="UserRights" asp-route-id="@item.Id" asp-controller="Profiles">
                                        <i class="fa-solid fa-user-shield"></i> Assign Rights
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="dropdown-item">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </td>
                        
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
